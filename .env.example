# GROQ_API_KEY / DORMIQA_API_KEY / CAMPORA_API_KEY: Required for Groq AI features.
# AI Studio automatically injects this at runtime from user secrets.
GROQ_API_KEY="MY_GROQ_API_KEY"
DORMIQA_API_KEY="MY_DORMIQA_API_KEY"
CAMPORA_API_KEY="MY_CAMPORA_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY / OPENAI_API_KEY / AI_API_KEY: Optional key for OpenRouter/OpenAI model endpoints
# Supports models like openai/gpt-oss-120b, qwen/qwen3.6-27b, etc.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# ADMIN_PASSWORD: Secure password for discreet Dormiqa Admin Access.
ADMIN_PASSWORD="Dormiqa26/27"

# SMTP Email Transport Configuration (for dispatching 6-digit OTP verification codes)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="no-reply@dormiqa.ng"
SMTP_PASS="your-app-password"
EMAIL_FROM="Dormiqa <no-reply@dormiqa.ng>"
SENDGRID_API_KEY=""


