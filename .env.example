# GROQ_API_KEY / DORMIQA_API_KEY / CAMPORA_API_KEY: Required for Groq AI features.
# AI Studio automatically injects this at runtime from user secrets.
GROQ_API_KEY="MY_GROQ_API_KEY"
DORMIQA_API_KEY="MY_DORMIQA_API_KEY"
CAMPORA_API_KEY="MY_CAMPORA_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY / OPENAI_API_KEY / AI_API_KEY: Optional key for OpenRouter/OpenAI model endpoints
# Supports models like openai/gpt-oss-120b, qwen/qwen3.6-27b, etc.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# ADMIN_PASSWORD: not used anywhere in this codebase — admin access is now
# handled via Firebase Google Sign-In + server-side ID token verification
# (see /api/admin/login). This variable is unused dead config.
# IMPORTANT: if "Dormiqa26/27" (the value previously committed here) is
# reused as a real password anywhere else (hosting panel, another service,
# etc.), rotate it — it has been sitting in this public repo's history.
# ADMIN_PASSWORD="unused_remove_if_confirmed_dead"


