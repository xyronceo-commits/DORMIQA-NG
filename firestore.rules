rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isInitialSuperAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == 'buildsafe247@gmail.com' || (request.auth.token.email_verified == true && request.auth.token.email == 'buildsafe247@gmail.com'));
    }

    function isAdmin() {
      return isSignedIn() && (
        isInitialSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/authorized_admins/$(request.auth.token.email))
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        isInitialSuperAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SUPER_ADMIN') ||
        (exists(/databases/$(database)/documents/authorized_admins/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/authorized_admins/$(request.auth.token.email)).data.role == 'SUPER_ADMIN')
      );
    }

    // ADMINS COLLECTION
    // NOTE: previously "allow read: if true" — publicly exposed the full
    // roster of admin emails/roles to anyone, even unauthenticated. That's
    // reconnaissance value for an attacker and is restricted to admins now.
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if isInitialSuperAdmin() || isSuperAdmin();
    }

    // AUTHORIZED ADMINS COLLECTION
    match /authorized_admins/{adminEmailDoc} {
      allow read: if isAdmin();
      allow write: if isInitialSuperAdmin() || isSuperAdmin();
    }

    // USERS COLLECTION
    // Public agent-facing info (name, avatar, phone) is denormalized onto
    // Listing documents for marketplace browsing, so the marketplace UI
    // doesn't need to read another user's full profile — restrict full
    // profile reads to the owner or an admin to avoid exposing phone
    // numbers / verification details to every signed-in user.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isInitialSuperAdmin());
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerifiedAgent', 'verifiedAt', 'verifiedBy', 'businessVerificationStatus'])));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // STUDENTS COLLECTION
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == studentId);
    }

    // AGENTS COLLECTION
    match /agents/{agentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == agentId || isAdmin()) && (!('isVerifiedAgent' in request.resource.data) || request.resource.data.isVerifiedAgent == false || isAdmin());
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == agentId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerifiedAgent', 'businessVerificationStatus', 'verifiedAt', 'verifiedBy'])));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == agentId);
    }

    // UNIVERSITIES COLLECTION
    match /universities/{universityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // LISTINGS COLLECTION
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        ('agentId' in request.resource.data && request.auth.uid == request.resource.data.agentId) || 
        ('userId' in request.resource.data && request.auth.uid == request.resource.data.userId) || 
        isAdmin()
      );
      allow update: if isAdmin() || (
        isSignedIn() && (
          (resource != null && 'agentId' in resource.data && request.auth.uid == resource.data.agentId) ||
          (resource != null && 'userId' in resource.data && request.auth.uid == resource.data.userId) ||
          ('agentId' in request.resource.data && request.auth.uid == request.resource.data.agentId) ||
          ('userId' in request.resource.data && request.auth.uid == request.resource.data.userId)
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          (resource != null && 'agentId' in resource.data && request.auth.uid == resource.data.agentId) ||
          (resource != null && 'userId' in resource.data && request.auth.uid == resource.data.userId)
        )
      );
    }

    // REMOVAL AUDITS COLLECTION
    match /removal_audits/{auditId} {
      allow read, write: if isAdmin();
    }

    // INSPECTIONS COLLECTION
    match /inspections/{inspectionId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.studentId || request.auth.uid == resource.data.agentId || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == request.resource.data.studentId || request.auth.uid == request.resource.data.agentId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == resource.data.studentId || request.auth.uid == resource.data.agentId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.studentId || request.auth.uid == resource.data.agentId || isAdmin());
    }

    // CONVERSATIONS COLLECTION
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.studentId || request.auth.uid == resource.data.agentId || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == request.resource.data.studentId || request.auth.uid == request.resource.data.agentId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == resource.data.studentId || request.auth.uid == resource.data.agentId || isAdmin());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.studentId == request.auth.uid || get(/databases/$(database)/documents/conversations/$(conversationId)).data.agentId == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && (request.auth.uid == request.resource.data.senderId || isAdmin());
        allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.senderId);
      }
    }

    // REPORTS COLLECTION
    match /reports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reportedBy == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // NOTIFICATIONS COLLECTION
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.recipientId || request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.recipientId || request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.recipientId || request.auth.uid == resource.data.userId || isAdmin());
    }

    // REVIEWS COLLECTION
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // EMAIL VERIFICATIONS COLLECTION
    match /emailVerifications/{verificationId} {
      allow read, write: if isAdmin();
    }
  }
}
