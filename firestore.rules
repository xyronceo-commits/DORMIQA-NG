rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null || resource == null;
    }

    // LISTINGS COLLECTION
    match /listings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null || resource == null;
    }

    // INSPECTIONS COLLECTION
    match /inspections/{inspectionId} {
      allow read, write: if request.auth != null || resource == null;
    }

    // CONVERSATIONS COLLECTION
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null || resource == null;

      // MESSAGES SUBCOLLECTION
      match /messages/{messageId} {
        allow read, write: if request.auth != null || resource == null;
      }
    }

    // REPORTS COLLECTION
    match /reports/{reportId} {
      allow read: if true;
      allow write: if request.auth != null || resource == null;
    }

    // NOTIFICATIONS COLLECTION
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null || resource == null;
    }

    // REVIEWS COLLECTION
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null || resource == null;
    }

    // EMAIL VERIFICATIONS COLLECTION
    match /emailVerifications/{verificationId} {
      allow read, write: if true;
    }

    // AUTHORIZED ADMINS COLLECTION
    match /authorized_admins/{adminEmailDoc} {
      allow read: if true;
      allow write: if request.auth != null || resource == null;
    }
  }
}
