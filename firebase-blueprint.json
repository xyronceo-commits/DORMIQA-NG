        { "name": "address", "type": "string", "description": "Full street address" },
        { "name": "availableUnits", "type": "number", "description": "Number of vacant rooms" },
        { "name": "isFeatured", "type": "boolean", "description": "Featured placement flag" },
        { "name": "status", "type": "string", "description": "active, pending, rejected" },
        { "name": "createdAt", "type": "string", "description": "Creation ISO date" }
      ]
    },
    {
      "name": "inspections",
      "fields": [
        { "name": "listingId", "type": "string", "description": "Target property ID" },
        { "name": "listingTitle", "type": "string", "description": "Property title" },
        { "name": "studentId", "type": "string", "description": "Student user ID" },
        { "name": "studentName", "type": "string", "description": "Student name" },
        { "name": "studentPhone", "type": "string", "description": "Student phone number" },
        { "name": "agentId", "type": "string", "description": "Agent or caretaker ID" },
        { "name": "date", "type": "string", "description": "Scheduled inspection date" },
        { "name": "timeSlot", "type": "string", "description": "Morning, Afternoon, Evening" },
        { "name": "status", "type": "string", "description": "pending, confirmed, completed, cancelled" },
        { "name": "notes", "type": "string", "description": "Special request or notes" },
        { "name": "createdAt", "type": "string", "description": "Booking timestamp" }
      ]
    },
    {
      "name": "conversations",
      "fields": [
        { "name": "studentId", "type": "string", "description": "Student ID" },
        { "name": "studentName", "type": "string", "description": "Student name" },
        { "name": "agentId", "type": "string", "description": "Agent ID" },
        { "name": "agentName", "type": "string", "description": "Agent name" },
        { "name": "listingId", "type": "string", "description": "Listing ID" },
        { "name": "listingTitle", "type": "string", "description": "Listing title" },
        { "name": "lastMessage", "type": "string", "description": "Text snippet of last message" },
