        { "name": "name", "type": "string", "description": "Full name of user" },
        { "name": "email", "type": "string", "description": "Email address" },
        { "name": "role", "type": "string", "description": "Role: student, agent, or admin" },
        { "name": "phone", "type": "string", "description": "Phone number" },
        { "name": "universityId", "type": "string", "description": "University ID if student" },
        { "name": "universityName", "type": "string", "description": "University name" },
        { "name": "agencyName", "type": "string", "description": "Agency name if agent" },
        { "name": "avatarUrl", "type": "string", "description": "Profile picture URL" },
        { "name": "isVerifiedAgent", "type": "boolean", "description": "Verification status" },
        { "name": "businessVerificationStatus", "type": "string", "description": "Status: pending, approved, rejected, none" },
        { "name": "businessVerificationDetails", "type": "object", "description": "Details of business verification application" },
        { "name": "licenseNumber", "type": "string", "description": "Agent license number" },
        { "name": "rejectionReason", "type": "string", "description": "Reason if verification was rejected" },
        { "name": "createdAt", "type": "string", "description": "Creation timestamp" }
      ]
    },
    {
      "name": "listings",
      "fields": [
        { "name": "title", "type": "string", "description": "Property title" },
        { "name": "price", "type": "number", "description": "Price per period in NGN" },
