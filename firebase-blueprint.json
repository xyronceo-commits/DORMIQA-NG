        { "name": "unreadCountAgent", "type": "number", "description": "Unread messages for agent" }
      ]
    },
    {
      "name": "reports",
      "fields": [
        { "name": "listingId", "type": "string", "description": "Listing ID reported" },
        { "name": "listingTitle", "type": "string", "description": "Property title" },
        { "name": "reportedBy", "type": "string", "description": "User ID of reporter" },
        { "name": "reason", "type": "string", "description": "Scam category/reason" },
        { "name": "details", "type": "string", "description": "Explanation details" },
        { "name": "status", "type": "string", "description": "open, investigating, resolved, dismissed" },
        { "name": "createdAt", "type": "string", "description": "Timestamp" }
      ]
    },
    {
      "name": "notifications",
      "fields": [
        { "name": "userId", "type": "string", "description": "Target recipient user ID" },
        { "name": "title", "type": "string", "description": "Notification title" },
        { "name": "body", "type": "string", "description": "Notification message body" },
        { "name": "type", "type": "string", "description": "message, inspection, listing, or system" },
        { "name": "read", "type": "boolean", "description": "Read flag" },
        { "name": "universityId", "type": "string", "description": "Optional university filter ID" },
        { "name": "createdAt", "type": "string", "description": "ISO creation date" }
      ]
    },
    {
      "name": "reviews",
      "fields": [
        { "name": "listingId", "type": "string", "description": "Target listing ID" },
        { "name": "authorName", "type": "string", "description": "Student reviewer name" },
        { "name": "authorAvatar", "type": "string", "description": "Student avatar URL" },
        { "name": "rating", "type": "number", "description": "Star rating 1-5" },
        { "name": "comment", "type": "string", "description": "Written feedback comment" },
        { "name": "universityCourse", "type": "string", "description": "Student course / department" },
        { "name": "tag", "type": "string", "description": "Verified Visitor, Inspection Tour, Resident Student" },
        { "name": "createdAt", "type": "string", "description": "Timestamp" }
      ]
    },
    {
      "name": "emailVerifications",
      "fields": [
        { "name": "email", "type": "string", "description": "Recipient email address" },
        { "name": "userId", "type": "string", "description": "Associated user ID or null" },
        { "name": "otpHash", "type": "string", "description": "SHA-256 hashed 6-digit OTP code" },
        { "name": "createdAt", "type": "number", "description": "Creation timestamp in milliseconds" },
        { "name": "expiresAt", "type": "number", "description": "Expiration timestamp in milliseconds" },
        { "name": "attempts", "type": "number", "description": "Verification attempts count" },
        { "name": "used", "type": "boolean", "description": "Whether the OTP has been used or invalidated" },
        { "name": "verified", "type": "boolean", "description": "Whether email was successfully verified" }
      ]
    },
    {
      "name": "authorized_admins",
      "fields": [
        { "name": "email", "type": "string", "description": "Authorized administrator email address" },
        { "name": "addedBy", "type": "string", "description": "Email address of who granted authorization" },
        { "name": "createdAt", "type": "string", "description": "Creation ISO date" }
      ]
    }
